{
  // security subgraph Worker with its own D1 database (apollo-demo security_db).
  "name": "lnl-security-subgraph",
  "main": "src/index.js",
  "workers_dev": false,  // internal: reached only through service bindings and queues
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.graphql"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "lnl-security", "database_id": "b7b73292-5bee-4629-ba59-6fae3f0a12f5", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
