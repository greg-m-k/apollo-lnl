{
  // security-events: REST writes + transactional outbox; the relay publishes to the lnl-events-security-badge queue.
  "name": "lnl-security-events",
  "main": "src/index.js",
  "workers_dev": false,  // internal: reached only through service bindings and queues
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "lnl-security-events", "database_id": "6fe30972-2b0b-4f4e-8f39-175f65b4e2a4", "migrations_dir": "migrations" }],
  "queues": { "producers": [{ "binding": "TOPIC", "queue": "lnl-events-security-badge" }] },
  "durable_objects": { "bindings": [
    { "name": "RELAY", "class_name": "OutboxRelay" },
    { "name": "LESSON", "class_name": "Lesson", "script_name": "lnl-lesson" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OutboxRelay"] }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
