{
  // The Lunch & Learn site and its same-origin API gateway.
  "name": "lnl-web",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/effects/*"] },
  "services": [
    { "binding": "ROUTER", "service": "lnl-router" },
    { "binding": "HR_EVENTS", "service": "lnl-hr-events" },
    { "binding": "EMPLOYMENT_EVENTS", "service": "lnl-employment-events" },
    { "binding": "SECURITY_EVENTS", "service": "lnl-security-events" },
    { "binding": "QUERY", "service": "lnl-query-service" },
    { "binding": "CONSUMER", "service": "lnl-projection-consumer" },
    // The useEffect topic (repo greg-m-k/useeffect-lnl), served below /effects/.
    { "binding": "EFFECTS", "service": "lnl-effects" }
  ],
  "durable_objects": { "bindings": [{ "name": "LESSON", "class_name": "Lesson", "script_name": "lnl-lesson" }] },
  "routes": [{ "pattern": "lnl.greg.kitchen", "custom_domain": true }]
}
